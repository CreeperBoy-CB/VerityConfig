# Gradle 构建和缓存
.gradle/
build/
out/
classes/

# Forge 运行目录（包含服务器/客户端配置、存档等）
run/
# data run 配置的 workingDirectory（gradlew runData 会生成）
run-data/
# 本模组自己的缓存目录，只在游戏目录下出现；这里一并挡掉以防万一
.cache/

# Maven 发布输出目录（gradlew publish 会生成）
mcmodsrepo/

# IDE 配置文件（IDEA）
.idea/
*.iml
*.ipr
*.iws

# IDE 配置文件（Eclipse 等）
.classpath
.project
.settings/
bin/

# 日志文件
*.log
logs/

# 构建产物
*.jar
*.zip
*.tar.gz
*.rar

# 系统文件
Thumbs.db
.DS_Store
